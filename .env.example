# Server
PORT=3000
NODE_ENV=development

# JWT
# Must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Expected issuer (iss) claim; tokens with a different issuer are rejected
JWT_ISSUER=stellar-tags

# Rate limiting
# Requests allowed per window for anonymous (unauthenticated) callers
RATE_LIMIT_ANONYMOUS=60
# Requests allowed per window for authenticated callers (valid X-Api-Key)
RATE_LIMIT_AUTHENTICATED=600
# Window length in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# Origin cache
# TTL in milliseconds for the approved CORS origins cache (default 5 minutes)
ORIGIN_CACHE_TTL_MS=300000

# Database connection pool
# Maximum number of connections in the Prisma connection pool (default 10)
DB_POOL_SIZE=10
# Timeout in seconds for acquiring a connection from the pool (default 30)
DB_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Local development bootstrap
# ---------------------------------------------------------------------------
# The values below are LOCAL-ONLY defaults used by the one-command bootstrap
# (`npm run bootstrap` / `./scripts/bootstrap.sh`). They point at isolated,
# containerized services started by the bootstrap and MUST NOT be used to
# reach production resources. The bootstrap refuses to run when NODE_ENV is
# "production" or when any of these URLs resolve to a non-local host.

# Isolated local Postgres started by the bootstrap (non-production).
# Host/port are local-only; the bootstrap waits for readiness before migrating.
DATABASE_URL=postgresql://stellar:stellar@127.0.0.1:5432/stellar_tags_dev
# Direct (non-pooled) URL used for migrations against the local database.
DIRECT_DATABASE_URL=postgresql://stellar:stellar@127.0.0.1:5432/stellar_tags_dev

# Isolated local Redis started by the bootstrap (non-production).
REDIS_URL=redis://127.0.0.1:6379

# Ports exposed by the local services (must be free before bootstrap starts).
# The bootstrap fails with an actionable message if a port is already in use.
LOCAL_DB_PORT=5432
LOCAL_REDIS_PORT=6379

# Bootstrap readiness behavior
# Total seconds to wait for each service to report ready before failing.
BOOTSTRAP_READY_TIMEOUT_SECONDS=60
# Seconds between readiness probes while waiting for services.
BOOTSTRAP_READY_INTERVAL_SECONDS=2