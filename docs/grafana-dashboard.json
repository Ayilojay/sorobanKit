    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Rolling 28-day availability SLI per user-facing flow: successful requests / total requests. Excludes client errors (4xx) and requests marked as excluded (health checks, synthetic probes). Objectives: registration >= 99.9%, federation lookup >= 99.9%, payment >= 99.95%.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.999 },
              { "color": "green", "value": 0.9995 }
            ]
          },
          "unit": "percentunit",
          "min": 0.99,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 21,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (flow) (rate(stellar_tags_sli_requests_total{instance=~\"$instance\",excluded=\"false\",outcome=\"success\"}[28d])) / sum by (flow) (rate(stellar_tags_sli_requests_total{instance=~\"$instance\",excluded=\"false\",outcome=~\"success|failure\"}[28d]))",
          "legendFormat": "{{flow}}",
          "refId": "A"
        }
      ],
      "title": "Availability SLI (28d rolling) - registration / federation_lookup / payment",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Rolling 28-day latency SLI per user-facing flow: fraction of non-excluded requests served within the flow's latency objective. Objectives: registration p99 <= 500ms, federation lookup p99 <= 300ms, payment p99 <= 1000ms.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
