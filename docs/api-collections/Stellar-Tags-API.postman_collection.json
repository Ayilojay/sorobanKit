{
  "info": {
    "name": "Stellar Tags API",
    "description": "API Blueprint Collection for Stellar Tags (/lookup, /register, /health, and /transactions/export), following standardized JSON response and error envelopes according to JSend/API error specifications.\n\nAPI Versioning: clients may select the API version via the `API-Version` header (e.g. `API-Version: 2`) or via the URL prefix (`/v1/...` or `/v2/...`). When neither is provided the API defaults to v1. See the \"API Versioning\" section of the README for the v1 -> v2 change log and the v1 end-of-life date.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Check if the API is running."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {"method": "GET", "header": [], "url": {"raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"]}},
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"status\": \"ok\",\n  \"uptime\": 12345.67\n}"
        }
      ]
    },
    {
      "name": "Register User",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"address\": \"GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4\",\n  \"memo_type\": \"text\",\n  \"memo\": \"My Memo\",\n  \"signature\": \"\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {"raw": "{{baseUrl}}/register", "host": ["{{baseUrl}}"], "path": ["register"]},
        "description": "Registers a new user address with a name tag."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{baseUrl}}/register", "host": ["{{baseUrl}}"], "path": ["register"]}},
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"username\": \"testuser\",\n    \"address\": \"GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4\"\n  }\n}"
        },
        {
          "name": "400 Bad Request",
          "originalRequest": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{baseUrl}}/register", "host": ["{{baseUrl}}"], "path": ["register"]}},
          "status": "Bad Request",
          "code": 400,
          "_postman_previewlanguage": "json",
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"status\": \"error\",\n  \"message\": \"Invalid Stellar address\"\n}"
        }
      ]
    },
    {
      "name": "Lookup User",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/lookup?address=GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4&search=test&page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["lookup"],
          "query": [
            {"key": "address", "value": "GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4", "description": "Search by exact Stellar public key (optional)."},
            {"key": "search", "value": "test", "description": "Search by username or address (optional, paginated)."},
            {"key": "page", "value": "1", "description": "Pagination page number (default: 1)."},
            {"key": "limit", "value": "10", "description": "Results per page (default: 10, max: 100)."}
          ]
        },
        "description": "Looks up a user's details by their Stellar address or name."
      },
      "response": []
    },
    {
      "name": "Export Transactions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/transactions/export?address=GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions",
            "export"
          ],
          "query": [
            {
              "key": "address",
              "value": "GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4",
              "description": "Stellar public key whose transactions should be exported."
            }
          ]
        },
        "description": "Exports the transaction history for a Stellar address.\n\nResponses:\n- 200 OK: Returns the exported transaction data.\n- 404 NOT_FOUND: The address was not found on Horizon. This typically means the account has never been funded. Error message: \"Account not found on Horizon. The address may not yet be funded.\"\n- 500 INTERNAL_ERROR: An unexpected error occurred while contacting Horizon."
      },
      "response": []
    },
    {
      "name": "Admin - Create Export Job",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "X-Admin-API-Key", "value": "{{adminApiKey}}", "description": "Admin API key identifying the job owner."}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"address\": \"GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4\",\n  \"format\": \"csv\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {"raw": "{{baseUrl}}/admin/exports", "host": ["{{baseUrl}}"], "path": ["admin", "exports"]},
        "description": "Creates a durable, cancellable background export job for a Stellar address.\n\nThe request returns immediately with a job id; the export is processed asynchronously by a bounded worker pool and streamed to artifact storage instead of being buffered in memory.\n\nResponses:\n- 202 Accepted: Job created. Poll `GET /admin/exports/{jobId}` for progress.\n- 400 BAD_REQUEST: Invalid address or format.\n- 401 UNAUTHORIZED: Missing or invalid admin API key.\n- 429 TOO_MANY_REQUESTS: Too many concurrent export jobs for this owner."
      },
      "response": [
        {
          "name": "202 Accepted",
          "originalRequest": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "X-Admin-API-Key", "value": "{{adminApiKey}}"}], "url": {"raw": "{{baseUrl}}/admin/exports", "host": ["{{baseUrl}}"], "path": ["admin", "exports"]}},
          "status": "Accepted",
          "code": 202,
          "_postman_previewlanguage": "json",
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"jobId\": \"exp_01HZX8Q2K7YV3M4N5P6R7S8T9V\",\n    \"state\": \"queued\",\n    \"progress\": 0,\n    \"createdAt\": \"2024-01-01T00:00:00.000Z\",\n    \"expiresAt\": null,\n    \"downloadUrl\": null\n  }\n}"
        },
        {
          "name": "401 Unauthorized",
          "originalRequest": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": {"raw": "{{baseUrl}}/admin/exports", "host": ["{{baseUrl}}"], "path": ["admin", "exports"]}},
          "status": "Unauthorized",
          "code": 401,
          "_postman_previewlanguage": "json",
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"status\": \"error\",\n  \"message\": \"Missing or invalid admin API key\"\n}"
        }
      ]
    },
    {
      "name": "Admin - Get Export Job Status",
      "request": {
        "method": "GET",
        "header": [
          {"key": "X-Admin-API-Key", "value": "{{adminApiKey}}", "description": "Must match the key that created the job (ownership check)."}
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/exports/{{exportJobId}}",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "exports", "{{exportJobId}}"]
        },
        "description": "Returns the current state and progress of an export job.\n\nStates: `queued`, `running`, `completed`, `failed`, `cancelled`, `expired`.\n\nResponses:\n- 200 OK: Job status. `progress` is a percentage (0-100). When `completed`, `downloadUrl` and `expiresAt` are populated.\n- 403 FORBIDDEN: The job belongs to a different owner.\n- 404 NOT_FOUND: Unknown job id."
      },
      "response": [
        {
          "name": "200 OK (running)",
          "originalRequest": {"method": "GET", "header": [{"key": "X-Admin-API-Key", "value": "{{adminApiKey}}"}], "url": {"raw": "{{baseUrl}}/admin/exports/{{exportJobId}}", "host": ["{{baseUrl}}"], "path": ["admin", "exports", "{{exportJobId}}"]}},
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"jobId\": \"exp_01HZX8Q2K7YV3M4N5P6R7S8T9V\",\n    \"state\": \"running\",\n    \"progress\": 42,\n    \"createdAt\": \"2024-01-01T00:00:00.000Z\",\n    \"expiresAt\": null,\n    \"downloadUrl\": null\n  }\n}"
        },
        {
          "name": "200 OK (completed)",
          "originalRequest": {"method": "GET", "header": [{"key": "X-Admin-API-Key", "value": "{{adminApiKey}}"}], "url": {"raw": "{{baseUrl}}/admin/exports/{{exportJobId}}", "host": ["{{baseUrl}}"], "path": ["admin", "exports", "{{exportJobId}}"]}},
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"jobId\": \"exp_01HZX8Q2K7YV3M4N5P6R7S8T9V\",\n    \"state\": \"completed\",\n    \"progress\": 100,\n    \"createdAt\": \"2024-01-01T00:00:00.000Z\",\n    \"expiresAt\": \"2024-01-01T01:00:00.000Z\",\n    \"downloadUrl\": \"{{baseUrl}}/admin/exports/exp_01HZX8Q2K7YV3M4N5P6R7S8T9V/download\"\n  }\n}"
        },
        {
          "name": "403 Forbidden",
          "originalRequest": {"method": "GET", "header": [{"key": "X-Admin-API-Key", "value": "{{adminApiKey}}"}], "url": {"raw": "{{baseUrl}}/admin/exports/{{exportJobId}}", "host": ["{{baseUrl}}"], "path": ["admin", "exports", "{{exportJobId}}"]}},
          "status": "Forbidden",
          "code": 403,
          "_postman_previewlanguage": "json",
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"status\": \"error\",\n  \"message\": \"Export job does not belong to this owner\"\n}"
        }
      ]
    },
    {
      "name": "Admin - Cancel Export Job",
      "request": {
        "method": "DELETE",
        "header": [
          {"key": "X-Admin-API-Key", "value": "{{adminApiKey}}", "description": "Must match the key that created the job (ownership check)."}
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/exports/{{exportJobId}}",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "exports", "{{exportJobId}}"]
        },
        "description": "Requests cancellation of a queued or running export job. Cancellation is cooperative: the worker stops at the next checkpoint and any partial artifact is discarded.\n\nResponses:\n- 200 OK: Job cancelled (state becomes `cancelled`).\n- 403 FORBIDDEN: The job belongs to a different owner.\n- 404 NOT_FOUND: Unknown job id.\n- 409 CONFLICT: The job already finished (`completed`, `failed` or `expired`) and cannot be cancelled."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {"method": "DELETE", "header": [{"key": "X-Admin-API-Key", "value": "{{adminApiKey}}"}], "url": {"raw": "{{baseUrl}}/admin/exports/{{exportJobId}}", "host": ["{{baseUrl}}"], "path": ["admin", "exports", "{{exportJobId}}"]}},
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"jobId\": \"exp_01HZX8Q2K7YV3M4N5P6R7S8T9V\",\n    \"state\": \"cancelled\",\n    \"progress\": 42,\n    \"createdAt\": \"2024-01-01T00:00:00.000Z\",\n    \"expiresAt\": null,\n    \"downloadUrl\": null\n  }\n}"
        },
        {
          "name": "409 Conflict",
          "originalRequest": {"method": "DELETE", "header": [{"key": "X-Admin-API-Key", "value": "{{adminApiKey}}"}], "url": {"raw": "{{baseUrl}}/admin/exports/{{exportJobId}}", "host": ["{{baseUrl}}"], "path": ["admin", "exports", "{{exportJobId}}"]}},
          "status": "Conflict",
          "code": 409,
          "_postman_previewlanguage": "json",
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"status\": \"error\",\n  \"message\": \"Export job has already finished and cannot be cancelled\"\n}"
        }
      ]
    },
    {
      "name": "Admin - Download Export Artifact",
      "request": {
        "method": "GET",
        "header": [
          {"key": "X-Admin-API-Key", "value": "{{adminApiKey}}", "description": "Must match the key that created the job (ownership check)."}
        ],
        "url": {
          "raw": "{{baseUrl}}/admin/exports/{{exportJobId}}/download",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "exports", "{{exportJobId}}", "download"]
        },
        "description": "Streams the completed export artifact from artifact storage.\n\nResponses:\n- 200 OK: Streamed file body with `Content-Disposition: attachment`.\n- 403 FORBIDDEN: The job belongs to a different owner.\n- 404 NOT_FOUND: Unknown job id.\n- 409 CONFLICT: The job has not completed yet.\n- 410 GONE: The artifact has expired and been purged; create a new export job."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {"method": "GET", "header": [{"key": "X-Admin-API-Key", "value": "{{adminApiKey}}"}], "url": {"raw": "{{baseUrl}}/admin/exports/{{exportJobId}}/download", "host": ["{{baseUrl}}"], "path": ["admin", "exports", "{{exportJobId}}", "download"]}},
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "text",
          "header": [
            {"key": "Content-Type", "value": "text/csv"},
            {"key": "Content-Disposition", "value": "attachment; filename=\"export-exp_01HZX8Q2K7YV3M4N5P6R7S8T9V.csv\""}
          ],
          "body": "id,address,amount,asset,created_at\ntx_1,GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4,10.0,XLM,2024-01-01T00:00:00.000Z\n"
        },
        {
          "name": "410 Gone",
          "originalRequest": {"method": "GET", "header": [{"key": "X-Admin-API-Key", "value": "{{adminApiKey}}"}], "url": {"raw": "{{baseUrl}}/admin/exports/{{exportJobId}}/download", "host": ["{{baseUrl}}"], "path": ["admin", "exports", "{{exportJobId}}", "download"]}},
          "status": "Gone",
          "code": 410,
          "_postman_previewlanguage": "json",
          "header": [{"key": "Content-Type", "value": "application/json"}],
          "body": "{\n  \"status\": \"error\",\n  \"message\": \"Export artifact has expired\"\n}"
        }
      ]
    },
    {
      "name": "v2 - Lookup User (API-Version header)",
      "request": {
        "method": "GET",
        "header": [{"key": "API-Version", "value": "2", "description": "Selects API v2. Omit to default to v1."}],
        "url": {
          "raw": "{{baseUrl}}/lookup?address=GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4",
          "host": ["{{baseUrl}}"],
          "path": ["lookup"],
          "query": [
            {"key": "address", "value": "GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4", "description": "Search by exact Stellar public key (optional)."}
          ]
        },
        "description": "v2 example: selects API v2 via the `API-Version: 2` header. Responses include the `API-Version` header echoing the resolved version."
      },
      "response": [
        {
          "name": "200 OK (v2)",
          "originalRequest": {"method": "GET", "header": [{"key": "API-Version", "value": "2"}], "url": {"raw": "{{baseUrl}}/lookup?address=GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4", "host": ["{{baseUrl}}"], "path": ["lookup"]}},
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {"key": "Content-Type", "value": "application/json"},
            {"key": "API-Version", "value": "2"}
          ],
          "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"username\": \"testuser\",\n    \"address\": \"GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4\"\n  }\n}"
        }
      ]
    },
    {
      "name": "v2 - Register User (URL prefix)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"testuser\",\n  \"address\": \"GAE2S2XKT6H2A4ZJ6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4D6K4\",\n  \"memo_type\": \"text\",\n  \"memo\": \"My Memo\",\n  \"signature\": \"\"\n}",
          "options": {"raw": {"language": "json"}}
