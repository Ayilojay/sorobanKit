{
  "openapi": "3.1.0",
  "info": {
    "title": "Stellar Tags API",
    "version": "1.0.0",
    "description": "OpenAPI specification for the Stellar Tags API. Covers the documented endpoints for tags, addresses, activity, and stats. API errors use a stable envelope with a machine-readable code and retryable flag; validation details contain only field names and safe messages.\n\n## Soft-delete, restore, and username reuse semantics\n\n- **Reservation window**: when a tag (username) is soft-deleted, its name is reserved for a fixed `SOFT_DELETE_RESERVATION_DAYS` (default 30 days) from `deletedAt`. During this window the name cannot be claimed by any other owner.\n- **Restoration proof**: restoring a soft-deleted tag requires the original owner's authenticated identity (bearer token whose subject matches the tag's `ownerId`). The restore request must reference the tag id and the `deletedAt` value observed at deletion time; a mismatch (stale or already-restored) is rejected with `409 Conflict`.\n- **Post-expiry reuse**: once the reservation window elapses, the name becomes reusable. A new registration may claim it; the prior soft-deleted record is retained for audit but can no longer be restored (`410 Gone`).\n- **Transactional transitions**: delete, restore, and registration are enforced transactionally (row-level lock on the name). Concurrent delete/restore/registration cannot produce multiple active owners; losers receive `409 Conflict`.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    },
    {
      "url": "https://api.stellartags.example",
      "description": "Production server"
    }
  ],
  "tags": [
    { "name": "Tags", "description": "Stellar address tag operations" },
    { "name": "Addresses", "description": "Stellar address lookups" },
    { "name": "Activity", "description": "Activity feed with cursor pagination" },
    { "name": "Stats", "description": "Aggregate platform statistics" },
    { "name": "Admin", "description": "Administrative endpoints" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Platform"],
        "summary": "Check platform health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "All configured dependencies are healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthStatus" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/ApiErrorResponse" }
        }
      }
    },
    "/federation": {
      "get": {
        "tags": ["Addresses"],
        "summary": "Resolve a federation name or address",
        "operationId": "getFederation",
        "description": "Public metadata response. The `ETag` is computed from the canonical resolved federation data and changes whenever a user mutation changes the resolved result. Clients may send `If-None-Match` to receive `304 Not Modified` when the representation is unchanged. Responses are public-cacheable (`Cache-Control: public`) because they do not depend on the caller's authorization.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "type",
            "in": "query",
            "schema": { "type": "string", "enum": ["id", "name"] }
          },
          { "$ref": "#/components/parameters/IfNoneMatchParam" }
        ],
        "responses": {
          "200": {
            "description": "Resolved federation identity",
            "headers": {
              "ETag": { "$ref": "#/components/headers/ETagHeader" },
              "Cache-Control": { "$ref": "#/components/headers/PublicCacheControlHeader" },
              "Vary": { "$ref": "#/components/headers/VaryHeader" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FederationEntry" }
              }
            }
          },
          "304": { "$ref": "#/components/responses/NotModified" },
          "400": { "$ref": "#/components/responses/ApiErrorResponse" },
          "404": { "$ref": "#/components/responses/ApiErrorResponse" },
          "500": { "$ref": "#/components/responses/ApiErrorResponse" },
          "502": { "$ref": "#/components/responses/ApiErrorResponse" },
          "503": { "$ref": "#/components/responses/ApiErrorResponse" }
        }
      }
    },
    "/lookup": {
      "get": {
        "tags": ["Addresses"],
        "summary": "Look up registered usernames",
        "operationId": "lookupUsernames",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "search",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "all",
            "in": "query",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Lookup result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LookupResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ApiErrorResponse" },
          "404": { "$ref": "#/components/responses/ApiErrorResponse" },
          "500": { "$ref": "#/components/responses/ApiErrorResponse" },
          "503": { "$ref": "#/components/responses/ApiErrorResponse" }
        }
      }
    },
    "/api/tags": {
      "get": {
        "tags": ["Tags"],
        "summary": "List tags",
        "operationId": "listTags",
        "description": "Public metadata response. The `ETag` is computed from the canonical response data and is invalidated when user mutations change the resolved data. Supports `If-None-Match` conditional requests returning `304 Not Modified`.",
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/LimitParam" },
          { "name": "q", "in": "query", "description": "Search query", "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/IfNoneMatchParam" }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of tags",
            "headers": {
              "ETag": { "$ref": "#/components/headers/ETagHeader" },
              "Cache-Control": { "$ref": "#/components/headers/PublicCacheControlHeader" },
              "Vary": { "$ref": "#/components/headers/VaryHeader" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagList" }
              }
            }
          },
          "304": { "$ref": "#/components/responses/NotModified" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "post": {
        "tags": ["Tags"],
        "summary": "Create a tag",
        "operationId": "createTag",
        "description": "Registers a new tag (username). If the name was soft-deleted and its reservation window has not expired, registration is rejected with `409 Conflict`. Once the window expires the name is reusable.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TagInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tag created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/tags/bulk": {
      "post": {
        "tags": ["Tags"],
        "summary": "Create payment intents in bulk",
        "operationId": "createTagsBulk",
        "description": "Creates multiple payment intents atomically. Each request carries a client-supplied `batchId` (stable batch identifier) and each item carries a client-supplied `externalId` (stable item identifier). Persistence is all-or-nothing: if any item fails validation, no items are written and the response is `400` with per-item validation details. Item ordering in the response matches the request order. Retries are safe: repeating a request with the same `batchId` and `externalId` values returns the previously created batch (`200`) instead of creating duplicates; reusing an `externalId` with different content is rejected with `409 Conflict`.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BulkTagCreateInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay of a previously created batch",
            "headers": {
              "ETag": { "$ref": "#/components/headers/ETagHeader" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BulkTagCreateResult" }
              }
            }
          },
          "201": {
            "description": "All items created atomically",
            "headers": {
              "ETag": { "$ref": "#/components/headers/ETagHeader" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BulkTagCreateResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/tags/{id}": {
      "parameters": [
        { "$ref": "#/components/parameters/TagIdParam" }
      ],
      "get": {
        "tags": ["Tags"],
        "summary": "Get a tag by id",
        "operationId": "getTag",
        "responses": {
          "200": {
            "description": "Tag details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Tags"],
        "summary": "Update a tag",
        "operationId": "updateTag",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TagInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated tag",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tags"],
        "summary": "Soft-delete a tag",
        "operationId": "deleteTag",
        "description": "Soft-deletes the tag and starts the reservation window (`SOFT_DELETE_RESERVATION_DAYS`, default 30 days) during which the name cannot be reused. The transition is transactional; concurrent deletes/restores/registrations cannot create multiple owners.",
        "responses": {
          "204": { "description": "Tag soft-deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/tags/{id}/restore": {
      "parameters": [
        { "$ref": "#/components/parameters/TagIdParam" }
      ],
      "post": {
        "tags": ["Tags"],
        "summary": "Restore a soft-deleted tag",
        "operationId": "restoreTag",
        "description": "Restores a soft-deleted tag within its reservation window. Requires the original owner's authenticated identity and the `deletedAt` value observed at deletion time as restoration proof. Fails with `409 Conflict` on stale/already-restored state and `410 Gone` after the reservation window expires.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RestoreTagInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tag restored",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "410": { "$ref": "#/components/responses/Gone" }
        }
      }
    },
    "/api/addresses/{address}": {
      "get": {
        "tags": ["Addresses"],
        "summary": "Get tags for a Stellar address",
        "operationId": "getAddressTags",
        "parameters": [
          { "$ref": "#/components/parameters/AddressParam" }
        ],
        "responses": {
          "200": {
            "description": "Tags associated with the address",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/payments/events": {
      "get": {
        "tags": ["Payments"],
        "summary": "Stream payment status updates",
        "operationId": "streamPaymentEvents",
        "description": "Server-sent event (SSE) feed of payment status updates for the authenticated client. Each event is versioned (`event: payment.status`, `data` includes `version` and monotonic `sequence`). Clients reconnect with `Last-Event-ID` (or the `cursor` query parameter) to resume after the last received event; the server replays events after the cursor. Heartbeat comments are sent periodically to keep idle connections alive. The feed is bounded: a per-client connection limit applies (`429` when exceeded) and slow clients are disconnected rather than buffered indefinitely. Disconnects release all server resources. Responses are never shared-cached because they depend on the caller's authorization.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque reconnect cursor; equivalent to sending the `Last-Event-ID` header",
            "schema": { "type": "string" }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "description": "Standard SSE reconnect header carrying the last received event id",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Event stream",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/PrivateNoStoreCacheControlHeader" },
              "Vary": { "$ref": "#/components/headers/VaryHeader" }
            },
            "content": {
              "text/event-stream": {
                "schema": { "$ref": "#/components/schemas/PaymentEventStream" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/activity": {
      "get": {
        "tags": ["Activity"],
        "summary": "List activity feed entries",
        "operationId": "listActivity",
        "parameters": [
          { "$ref": "#/components/parameters/CursorParam" },
          { "$ref": "#/components/parameters/LimitParam" }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated activity feed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ActivityList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": ["Stats"],
        "summary": "Get platform statistics",
        "description": "Returns aggregate statistics served from the refreshable reporting read model. The response includes the source watermark and refresh status so clients can reason about staleness. Reporting refreshes run asynchronously and never block payment writes.",
        "operationId": "getStats",
        "responses": {
          "200": {
            "description": "Aggregate platform statistics from the reporting read model",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Stats" }
              }
            }
          }
        }
      }
    },
    "/api/admin/stats": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get admin statistics",
        "operationId": "getAdminStats",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Administrative statistics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Stats" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/stats/refresh": {
      "post": {
        "tags": ["Admin"],
        "summary": "Trigger a reporting read model refresh",
        "description": "Enqueues an asynchronous refresh of the reporting read model. The refresh runs decoupled from the payment write path and records the source watermark on completion. Returns the current refresh status.",
        "operationId": "refreshStats",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "202": {
            "description": "Refresh accepted and running asynchronously",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatsRefreshStatus" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": {
            "description": "A refresh is already in progress",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/StatsRefreshStatus" } }
            }
          }
        }
      },
      "get": {
        "tags": ["Admin"],
        "summary": "Get reporting read model refresh status",
        "description": "Returns the current refresh status and source watermark of the reporting read model.",
        "operationId": "getStatsRefreshStatus",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current refresh status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatsRefreshStatus" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "headers": {
      "ETagHeader": {
        "description": "Strong validator computed from the canonical response data",
        "schema": { "type": "string" }
      },
      "PublicCacheControlHeader": {
        "description": "Public caching directive for authorization-independent responses",
        "schema": { "type": "string", "example": "public, max-age=60" }
      },
      "PrivateNoStoreCacheControlHeader": {
        "description": "Prevents shared caching of authorization-dependent responses",
        "schema": { "type": "string", "example": "private, no-store" }
      },
      "VaryHeader": {
        "description": "Response varies on these request headers",
        "schema": { "type": "string", "example": "Accept, Accept-Encoding" }
      }
    },
    "parameters": {
      "IfNoneMatchParam": {
        "name": "If-None-Match",
        "in": "header",
        "description": "Conditional request validator; when it matches the current ETag the server responds `304 Not Modified`",
        "schema": { "type": "string" }
      },
      "PageParam": {
        "name": "page",
        "in": "query",
        "description": "Page number (1-based)",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "LimitParam": {
        "name": "limit",
        "in": "query",
        "description": "Maximum number of items per page",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "CursorParam": {
        "name": "cursor",
        "in": "query",
        "description": "Opaque cursor for pagination",
        "schema": { "type": "string" }
      },
      "TagIdParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Tag identifier",
        "schema": { "type": "string" }
      },
      "AddressParam": {
        "name": "address",
        "in": "path",
        "required": true,
        "description": "Stellar account address",
        "schema": { "type": "string" }
      },
      "TokenParam": {
        "name": "token",
        "in": "path",
        "required": true,
        "description": "Token identifier (asset code or contract address)",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "ApiErrorResponse": {
        "description": "A standardized API error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication required or invalid credentials",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated but not permitted (e.g. not the original owner)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Conflict": {
        "description": "State transition conflict (name reserved, stale restore proof, or concurrent transition lost)",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Gone": {
        "description": "Reservation window expired; the tag can no longer be restored",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "NotModified": {
        "description": "The `If-None-Match` validator matched the current ETag; the representation is unchanged",
        "headers": {
          "ETag": { "$ref": "#/components/headers/ETagHeader" },
          "Cache-Control": { "$ref": "#/components/headers/PublicCacheControlHeader" }
        }
      },
      "TooManyRequests": {
        "description": "Connection limit exceeded for this client",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      }
    },
    "schemas": {
      "TagInput": {
        "type": "object",
        "required": ["username", "address"],
        "properties": {
          "username": { "type": "string" },
          "address": { "type": "string" }
        }
      },
      "Tag": {
        "type": "object",
        "required": ["id", "username", "address"],
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "address": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "deletedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TagList": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } },
          "totalCount": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "currentPage": { "type": "integer" }
        }
      },
      "ActivityList": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "nextCursor": { "type": "string" },
          "hasMore": { "type": "boolean" }
        }
      },
      "Stats": {
        "type": "object",
        "description": "Aggregate metrics and the refresh watermark for the reporting read model.",
        "additionalProperties": true
      },
      "StatsRefreshStatus": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["idle", "refreshing", "succeeded", "failed"] },
          "sourceWatermark": { "type": "string", "format": "date-time" },
          "startedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time" },
          "error": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["success", "error"],
        "properties": {
          "success": { "type": "boolean", "const": false },
          "error": {
            "type": "object",
            "required": ["code", "message", "retryable"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_INPUT",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "METHOD_NOT_ALLOWED",
                  "GONE",
                  "CONFLICT",
                  "PAYLOAD_TOO_LARGE",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "VALIDATION_FAILED",
                  "RATE_LIMITED",
                  "INTERNAL_ERROR",
                  "UPSTREAM_ERROR",
                  "SERVICE_UNAVAILABLE"
                ]
              },
              "message": { "type": "string" },
              "retryable": { "type": "boolean" },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["field", "message"],
                  "properties": {
                    "field": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "correlation_id": { "type": "string" },
          "reference_id": { "type": "string" }
        }
      },
      "HealthStatus": {
        "type": "object",
        "required": ["status", "timestamp", "database", "redis", "horizon"],
        "properties": {
          "status": { "type": "string", "enum": ["UP"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "database": { "type": "string", "enum": ["up"] },
          "redis": { "type": "string", "enum": ["up", "not configured"] },
          "horizon": { "type": "string", "enum": ["up"] }
        }
      },
      "FederationEntry": {
        "type": "object",
        "required": ["stellar_address", "account_id"],
        "properties": {
          "stellar_address": { "type": "string" },
          "account_id": { "type": "string" },
          "memo_type": { "type": "string" },
          "memo": { "type": "string" }
        }
      },
      "LookupResult": {
        "type": "object",
        "properties": {
          "username": { "type": "string" },
          "address": { "type": "string" },
          "primary": { "type": "string" },
          "usernames": { "type": "array", "items": { "type": "string" } },
          "data": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "totalCount": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "currentPage": { "type": "integer" }
        }
      },
      "BulkTagCreateInput": {
        "type": "object",
        "required": ["batchId", "items"],
        "properties": {
          "batchId": {
            "type": "string",
            "description": "Client-supplied stable batch identifier; retries with the same value are idempotent"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "description": "Items are persisted atomically and returned in request order",
            "items": { "$ref": "#/components/schemas/BulkTagCreateItemInput" }
          }
        }
      },
      "BulkTagCreateItemInput": {
        "type": "object",
        "required": ["externalId", "username", "address"],
        "properties": {
          "externalId": {
            "type": "string",
            "description": "Client-supplied stable item identifier; repeating it with identical content is idempotent, differing content is rejected with 409 Conflict"
          },
          "username": { "type": "string" },
          "address": { "type": "string" }
        }
      },
      "BulkTagCreateResult": {
        "type": "object",
        "required": ["batchId", "items"],
        "properties": {
          "batchId": { "type": "string" },
          "items": {
            "type": "array",
            "description": "Created items in the same order as the request",
            "items": { "$ref": "#/components/schemas/BulkTagCreateItemResult" }
          }
        }
      },
      "BulkTagCreateItemResult": {
        "type": "object",
        "required": ["externalId", "status"],
        "properties": {
          "externalId": { "type": "string" },
          "status": { "type": "string", "enum": ["created", "existing"] },
          "tag": { "$ref": "#/components/schemas/Tag" }
        }
      },
      "PaymentEventStream": {
        "type": "string",
        "description": "SSE stream. Each `payment.status` event carries an `id` (reconnect cursor), `event` name, and JSON `data` with `version`, `sequence`, `paymentId`, and `status`. Heartbeats are sent as SSE comments (`: heartbeat`)."
      },
      "RestoreTagInput": {
        "type": "object",
        "required": ["deletedAt"],
        "properties": {
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The `deletedAt` value observed at deletion time; used as restoration proof. A mismatch is rejected with 409 Conflict."
          }
        }
      }
    }
  }
}
