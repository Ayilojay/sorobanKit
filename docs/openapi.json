{
  "openapi": "3.1.0",
  "info": {
    "title": "Stellar Tags API",
    "version": "1.0.0",
    "description": "OpenAPI specification for the Stellar Tags API. Covers the documented endpoints for tags, addresses, activity, and stats.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    },
    {
      "url": "https://api.stellartags.example",
      "description": "Production server"
    }
  ],
  "tags": [
    { "name": "Tags", "description": "Stellar address tag operations" },
    { "name": "Addresses", "description": "Stellar address lookups" },
    { "name": "Activity", "description": "Activity feed with cursor pagination" },
    { "name": "Stats", "description": "Aggregate platform statistics" },
    { "name": "Admin", "description": "Administrative endpoints" }
  ],
  "paths": {
    "/api/tags": {
      "get": {
        "tags": ["Tags"],
        "summary": "List tags",
        "operationId": "listTags",
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/LimitParam" },
          { "name": "q", "in": "query", "description": "Search query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of tags",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "post": {
        "tags": ["Tags"],
        "summary": "Create a tag",
        "operationId": "createTag",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TagInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tag created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/tags/{id}": {
      "parameters": [
        { "$ref": "#/components/parameters/TagIdParam" }
      ],
      "get": {
        "tags": ["Tags"],
        "summary": "Get a tag by id",
        "operationId": "getTag",
        "responses": {
          "200": {
            "description": "Tag details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Tags"],
        "summary": "Update a tag",
        "operationId": "updateTag",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TagInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated tag",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tags"],
        "summary": "Delete a tag",
        "operationId": "deleteTag",
        "responses": {
          "204": { "description": "Tag deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/addresses/{address}": {
      "get": {
        "tags": ["Addresses"],
        "summary": "Get tags for a Stellar address",
        "operationId": "getAddressTags",
        "parameters": [
          { "$ref": "#/components/parameters/AddressParam" }
        ],
        "responses": {
          "200": {
            "description": "Tags associated with the address",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/activity": {
      "get": {
        "tags": ["Activity"],
        "summary": "List activity feed entries",
        "operationId": "listActivity",
        "parameters": [
          { "$ref": "#/components/parameters/CursorParam" },
          { "$ref": "#/components/parameters/LimitParam" }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated activity feed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ActivityList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": ["Stats"],
        "summary": "Get platform statistics",
        "operationId": "getStats",
        "responses": {
          "200": {
            "description": "Aggregate platform statistics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Stats" }
              }
            }
          }
        }
      }
    },
    "/api/admin/stats": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get admin statistics",
        "operationId": "getAdminStats",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Administrative statistics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Stats" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/token-allowlist": {
      "get": {
        "tags": ["Admin"],
        "summary": "List token allowlist entries",
        "description": "Returns the governance-controlled token allowlist used to gate payment routing eligibility, including pending timelocked updates and emergency removals.",
        "operationId": "listTokenAllowlist",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Token allowlist entries",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenAllowlist" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/token-allowlist/{token}": {
      "parameters": [
        { "$ref": "#/components/parameters/TokenParam" }
      ],
      "get": {
        "tags": ["Admin"],
        "summary": "Get a token allowlist entry",
        "operationId": "getTokenAllowlistEntry",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Token allowlist entry",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenAllowlistEntry" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Admin"],
        "summary": "Schedule a timelocked allowlist update",
        "description": "Schedules an allowlist change that takes effect after the configured timelock delay. The change is recorded as pending until the delay elapses.",
        "operationId": "scheduleTokenAllowlistUpdate",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TokenAllowlistUpdateInput" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Timelocked update scheduled",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenAllowlistEntry" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "Emergency removal of a token",
        "description": "Immediately removes a token from the allowlist, bypassing the timelock. Existing refund claims for the token are preserved and remain claimable.",
        "operationId": "emergencyRemoveToken",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Token removed; refund claims preserved",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenAllowlistEntry" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "PageParam": {
        "name": "page",
        "in": "query",
        "description": "Page number (1-based)",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "LimitParam": {
        "name": "limit",
        "in": "query",
        "description": "Maximum number of items per page",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "CursorParam": {
        "name": "cursor",
        "in": "query",
        "description": "Opaque cursor for cursor-based pagination",
        "schema": { "type": "string" }
      },
      "TagIdParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Tag identifier",
        "schema": { "type": "string" }
      },
      "AddressParam": {
        "name": "address",
        "in": "path",
        "required": true,
        "description": "Stellar account address (G...)",
        "schema": { "type": "string", "pattern": "^G[A-Z2-7]{55}$" }
      },
      "TokenParam": {
        "name": "token",
        "in": "path",
        "required": true,
        "description": "Token identifier (asset code or contract address)",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Unauthorized": {
        "description": "Authentication required",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Forbidden": {
        "description": "Insufficient permissions",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      }
    },
    "schemas": {
      "TokenAllowlist": {
        "type": "object",
        "properties": {
          "timelockSeconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Configured timelock delay applied to non-emergency allowlist updates"
          },
          "entries": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TokenAllowlistEntry" }
          }
        },
        "required": ["timelockSeconds", "entries"]
      },
      "TokenAllowlistEntry": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "description": "Token identifier" },
          "status": {
            "type": "string",
            "enum": ["allowed", "pending", "removed"],
            "description": "Current eligibility status for payment routing"
          },
          "eligible": {
            "type": "boolean",
            "description": "Whether the token is currently eligible for payment routing"
          },
          "effectiveAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "When the pending change takes effect; null when not pending"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the entry was last modified"
          },
          "emergency": {
            "type": "boolean",
            "description": "True when the entry was removed via emergency removal"
          },
          "preservedRefundClaims": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of existing refund claims preserved after removal"
          }
        },
        "required": ["token", "status", "eligible", "updatedAt", "emergency", "preservedRefundClaims"]
      },
      "TokenAllowlistUpdateInput": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean",
            "description": "Whether the token should be eligible for payment routing after the timelock"
          },
          "reason": {
            "type": "string",
            "description": "Governance rationale recorded with the change"
          }
        },
        "required": ["allowed"]
      }
    }
  }
}
