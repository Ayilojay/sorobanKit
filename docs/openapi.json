{
  "openapi": "3.1.0",
  "info": {
    "title": "Stellar Tags API",
    "version": "1.0.0",
    "description": "OpenAPI specification for the Stellar Tags API. Covers the documented endpoints for tags, addresses, activity, and stats.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    },
    {
      "url": "https://api.stellartags.example",
      "description": "Production server"
    }
  ],
  "tags": [
    { "name": "Tags", "description": "Stellar address tag operations" },
    { "name": "Addresses", "description": "Stellar address lookups" },
    { "name": "Activity", "description": "Activity feed with cursor pagination" },
    { "name": "Stats", "description": "Aggregate platform statistics" },
    { "name": "Admin", "description": "Administrative endpoints" }
  ],
  "paths": {
    "/api/tags": {
      "get": {
        "tags": ["Tags"],
        "summary": "List tags",
        "operationId": "listTags",
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/LimitParam" },
          { "name": "q", "in": "query", "description": "Search query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of tags",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "post": {
        "tags": ["Tags"],
        "summary": "Create a tag",
        "operationId": "createTag",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TagInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tag created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/tags/{id}": {
      "parameters": [
        { "$ref": "#/components/parameters/TagIdParam" }
      ],
      "get": {
        "tags": ["Tags"],
        "summary": "Get a tag by id",
        "operationId": "getTag",
        "responses": {
          "200": {
            "description": "Tag details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Tags"],
        "summary": "Update a tag",
        "operationId": "updateTag",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TagInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated tag",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tags"],
        "summary": "Delete a tag",
        "operationId": "deleteTag",
        "responses": {
          "204": { "description": "Tag deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/addresses/{address}": {
      "get": {
        "tags": ["Addresses"],
        "summary": "Get tags for a Stellar address",
        "operationId": "getAddressTags",
        "parameters": [
          { "$ref": "#/components/parameters/AddressParam" }
        ],
        "responses": {
          "200": {
            "description": "Tags associated with the address",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/activity": {
      "get": {
        "tags": ["Activity"],
        "summary": "List activity feed entries",
        "operationId": "listActivity",
        "parameters": [
          { "$ref": "#/components/parameters/CursorParam" },
          { "$ref": "#/components/parameters/LimitParam" }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated activity feed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ActivityList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": ["Stats"],
        "summary": "Get platform statistics",
        "operationId": "getStats",
        "responses": {
          "200": {
            "description": "Aggregate platform statistics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Stats" }
              }
            }
          }
        }
      }
    },
    "/api/admin/stats": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get admin statistics",
        "operationId": "getAdminStats",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Administrative statistics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Stats" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/token-allowlist": {
      "get": {
        "tags": ["Admin"],
        "summary": "List token allowlist entries",
        "description": "Returns the governance-controlled token allowlist used to gate payment routing eligibility, including pending timelocked updates and emergency removals.",
        "operationId": "listTokenAllowlist",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Token allowlist entries",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenAllowlist" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/token-allowlist/{token}": {
      "parameters": [
        { "$ref": "#/components/parameters/TokenParam" }
      ],
      "get": {
        "tags": ["Admin"],
        "summary": "Get a token allowlist entry",
        "operationId": "getTokenAllowlistEntry",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Token allowlist entry",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenAllowlistEntry" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/admin/fee-policies": {
      "get": {
        "tags": ["Admin"],
        "summary": "List versioned per-asset fee policies",
        "description": "Returns the governance-controlled fee policies. Each asset may have a token-specific fee basis points and cap; assets without a policy fall back to the global configuration. Pending changes are queued through governance and applied only after approval.",
        "operationId": "listFeePolicies",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Fee policies including the global fallback and per-asset overrides",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FeePolicyList" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/fee-policies/{token}": {
      "parameters": [
        { "$ref": "#/components/parameters/TokenParam" }
      ],
      "get": {
        "tags": ["Admin"],
        "summary": "Get the effective fee policy for an asset",
        "description": "Returns the effective fee policy for the asset. When no asset-specific policy exists, the global configuration is returned with source set to global.",
        "operationId": "getFeePolicy",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Effective fee policy for the asset",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FeePolicy" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "PageParam": {
        "name": "page",
        "in": "query",
        "description": "Page number (1-based)",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "LimitParam": {
        "name": "limit",
        "in": "query",
        "description": "Maximum number of items per page",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "CursorParam": {
        "name": "cursor",
        "in": "query",
        "description": "Opaque cursor for pagination",
        "schema": { "type": "string" }
      },
      "TagIdParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Tag identifier",
        "schema": { "type": "string" }
      },
      "AddressParam": {
        "name": "address",
        "in": "path",
        "required": true,
        "description": "Stellar account address",
        "schema": { "type": "string" }
      },
      "TokenParam": {
        "name": "token",
        "in": "path",
        "required": true,
        "description": "Token identifier (asset code or contract address)",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Forbidden": {
        "description": "Insufficient permissions",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "Tag": {
        "type": "object",
        "required": ["id", "address", "name"],
        "properties": {
          "id": { "type": "string" },
          "address": { "type": "string" },
          "name": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "TagInput": {
        "type": "object",
        "required": ["address", "name"],
        "properties": {
          "address": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "TagList": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Tag" }
          },
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": { "type": "integer" }
        }
      },
      "ActivityList": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "type": "object" }
          },
          "nextCursor": { "type": ["string", "null"] }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "totalTags": { "type": "integer" },
          "totalAddresses": { "type": "integer" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TokenAllowlist": {
        "type": "object",
        "required": ["entries"],
        "properties": {
          "entries": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TokenAllowlistEntry" }
          }
        }
      },
      "TokenAllowlistEntry": {
        "type": "object",
        "required": ["token", "allowed"],
        "properties": {
          "token": { "type": "string" },
          "allowed": { "type": "boolean" },
          "pendingUpdate": { "type": ["object", "null"] },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "FeePolicy": {
        "type": "object",
        "required": ["token", "feeBps", "cap", "source", "version"],
        "description": "Effective fee policy for an asset. feeBps is applied to the amount using exact integer arithmetic (floor(amount * feeBps / 10000)) and the result is clamped to cap. When no asset-specific policy exists, the global configuration is used and source is global.",
        "properties": {
          "token": { "type": "string" },
          "feeBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Fee in basis points (1 bps = 0.01%)."
          },
          "cap": {
            "type": "integer",
            "minimum": 0,
            "description": "Maximum fee in the asset's smallest unit. The computed fee is clamped to this value."
          },
          "source": {
            "type": "string",
            "enum": ["asset", "global"],
            "description": "Whether the policy comes from an asset-specific override or the global fallback."
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "Monotonic version incremented on each governance-approved change."
          },
          "pendingChange": {
            "type": ["object", "null"],
            "description": "Queued governance change awaiting approval, if any.",
            "properties": {
              "feeBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
              "cap": { "type": "integer", "minimum": 0 },
              "effectiveAt": { "type": "string", "format": "date-time" }
            }
          },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "FeePolicyList": {
        "type": "object",
        "required": ["global", "assets"],
        "properties": {
          "global": { "$ref": "#/components/schemas/FeePolicy" },
          "assets": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/FeePolicy" }
          }
        }
      }
    }
  }
}
