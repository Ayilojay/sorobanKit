{
  "openapi": "3.1.0",
  "info": {
    "title": "Stellar Tags API",
    "version": "1.0.0",
    "description": "OpenAPI specification for the Stellar Tags API. Covers the documented endpoints for tags, addresses, activity, and stats. API errors use a stable envelope with a machine-readable code and retryable flag; validation details contain only field names and safe messages.\n\n## Soft-delete, restore, and username reuse semantics\n\n- **Reservation window**: when a tag (username) is soft-deleted, its name is reserved for a fixed `SOFT_DELETE_RESERVATION_DAYS` (default 30 days) from `deletedAt`. During this window the name cannot be claimed by any other owner.\n- **Restoration proof**: restoring a soft-deleted tag requires the original owner's authenticated identity (bearer token whose subject matches the tag's `ownerId`). The restore request must reference the tag id and the `deletedAt` value observed at deletion time; a mismatch (stale or already-restored) is rejected with `409 Conflict`.\n- **Post-expiry reuse**: once the reservation window elapses, the name becomes reusable. A new registration may claim it; the prior soft-deleted record is retained for audit but can no longer be restored (`410 Gone`).\n- **Transactional transitions**: delete, restore, and registration are enforced transactionally (row-level lock on the name). Concurrent delete/restore/registration cannot produce multiple active owners; losers receive `409 Conflict`.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    },
    {
      "url": "https://api.stellartags.example",
      "description": "Production server"
    }
  ],
  "tags": [
    { "name": "Tags", "description": "Stellar address tag operations" },
    { "name": "Addresses", "description": "Stellar address lookups" },
    { "name": "Activity", "description": "Activity feed with cursor pagination" },
    { "name": "Stats", "description": "Aggregate platform statistics" },
    { "name": "Admin", "description": "Administrative endpoints" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Platform"],
        "summary": "Check platform health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "All configured dependencies are healthy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthStatus" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/ApiErrorResponse" }
        }
      }
    },
    "/federation": {
      "get": {
        "tags": ["Addresses"],
        "summary": "Resolve a federation name or address",
        "operationId": "getFederation",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "type",
            "in": "query",
            "schema": { "type": "string", "enum": ["id", "name"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Resolved federation identity",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FederationEntry" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ApiErrorResponse" },
          "404": { "$ref": "#/components/responses/ApiErrorResponse" },
          "500": { "$ref": "#/components/responses/ApiErrorResponse" },
          "502": { "$ref": "#/components/responses/ApiErrorResponse" },
          "503": { "$ref": "#/components/responses/ApiErrorResponse" }
        }
      }
    },
    "/lookup": {
      "get": {
        "tags": ["Addresses"],
        "summary": "Look up registered usernames",
        "operationId": "lookupUsernames",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "search",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "all",
            "in": "query",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Lookup result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LookupResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ApiErrorResponse" },
          "404": { "$ref": "#/components/responses/ApiErrorResponse" },
          "500": { "$ref": "#/components/responses/ApiErrorResponse" },
          "503": { "$ref": "#/components/responses/ApiErrorResponse" }
        }
      }
    },
    "/api/tags": {
      "get": {
        "tags": ["Tags"],
        "summary": "List tags",
        "operationId": "listTags",
        "parameters": [
          { "$ref": "#/components/parameters/PageParam" },
          { "$ref": "#/components/parameters/LimitParam" },
          { "name": "q", "in": "query", "description": "Search query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of tags",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      },
      "post": {
        "tags": ["Tags"],
        "summary": "Create a tag",
        "operationId": "createTag",
        "description": "Registers a new tag (username). If the name was soft-deleted and its reservation window has not expired, registration is rejected with `409 Conflict`. Once the window expires the name is reusable.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TagInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tag created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/tags/{id}": {
      "parameters": [
        { "$ref": "#/components/parameters/TagIdParam" }
      ],
      "get": {
        "tags": ["Tags"],
        "summary": "Get a tag by id",
        "operationId": "getTag",
        "responses": {
          "200": {
            "description": "Tag details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Tags"],
        "summary": "Update a tag",
        "operationId": "updateTag",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TagInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated tag",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tags"],
        "summary": "Soft-delete a tag",
        "operationId": "deleteTag",
        "description": "Soft-deletes the tag and starts the reservation window (`SOFT_DELETE_RESERVATION_DAYS`, default 30 days) during which the name cannot be reused. The transition is transactional; concurrent deletes/restores/registrations cannot create multiple owners.",
        "responses": {
          "204": { "description": "Tag soft-deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/tags/{id}/restore": {
      "parameters": [
        { "$ref": "#/components/parameters/TagIdParam" }
      ],
      "post": {
        "tags": ["Tags"],
        "summary": "Restore a soft-deleted tag",
        "operationId": "restoreTag",
        "description": "Restores a soft-deleted tag within its reservation window. Requires the original owner's authenticated identity and the `deletedAt` value observed at deletion time as restoration proof. Fails with `409 Conflict` on stale/already-restored state and `410 Gone` after the reservation window expires.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RestoreTagInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tag restored",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tag" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "410": { "$ref": "#/components/responses/Gone" }
        }
      }
    },
    "/api/addresses/{address}": {
      "get": {
        "tags": ["Addresses"],
        "summary": "Get tags for a Stellar address",
        "operationId": "getAddressTags",
        "parameters": [
          { "$ref": "#/components/parameters/AddressParam" }
        ],
        "responses": {
          "200": {
            "description": "Tags associated with the address",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TagList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/activity": {
      "get": {
        "tags": ["Activity"],
        "summary": "List activity feed entries",
        "operationId": "listActivity",
        "parameters": [
          { "$ref": "#/components/parameters/CursorParam" },
          { "$ref": "#/components/parameters/LimitParam" }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated activity feed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ActivityList" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": ["Stats"],
        "summary": "Get platform statistics",
        "description": "Returns aggregate statistics served from the refreshable reporting read model. The response includes the source watermark and refresh status so clients can reason about staleness. Reporting refreshes run asynchronously and never block payment writes.",
        "operationId": "getStats",
        "responses": {
          "200": {
            "description": "Aggregate platform statistics from the reporting read model",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Stats" }
              }
            }
          }
        }
      }
    },
    "/api/admin/stats": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get admin statistics",
        "description": "Requires the `admin:read` permission.",
        "operationId": "getAdminStats",
        "security": [{ "bearerAuth": [] }],
        "x-required-permission": "admin:read",
        "responses": {
          "200": {
            "description": "Administrative statistics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Stats" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/stats/refresh": {
      "post": {
        "tags": ["Admin"],
        "summary": "Trigger a reporting read model refresh",
        "description": "Enqueues an asynchronous refresh of the reporting read model. The refresh runs decoupled from the payment write path and records the source watermark on completion. Returns the current refresh status. Requires the `admin:operate` permission.",
        "operationId": "refreshStats",
        "security": [{ "bearerAuth": [] }],
        "x-required-permission": "admin:operate",
        "responses": {
          "202": {
            "description": "Refresh accepted and running asynchronously",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatsRefreshStatus" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": {
            "description": "A refresh is already in progress",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/StatsRefreshStatus" } }
            }
          }
        }
      },
      "get": {
        "tags": ["Admin"],
        "summary": "Get reporting read model refresh status",
        "description": "Returns the current refresh status and source watermark of the reporting read model. Requires the `admin:read` permission.",
        "operationId": "getStatsRefreshStatus",
        "security": [{ "bearerAuth": [] }],
        "x-required-permission": "admin:read",
        "responses": {
          "200": {
            "description": "Current refresh status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatsRefreshStatus" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/api-keys/{id}/rotate": {
      "parameters": [
        { "$ref": "#/components/parameters/ApiKeyIdParam" }
      ],
      "post": {
        "tags": ["Admin"],
        "summary": "Rotate an API key with a bounded overlap window",
        "description": "Issues a successor API key and schedules revocation of the predecessor at the end of a bounded overlap window (default 24 hours, capped by `API_KEY_ROTATION_MAX_OVERLAP_HOURS`). Both keys are accepted during the overlap; the predecessor is revoked immediately at the end of the window. The response contains the raw successor key material exactly once; subsequent reads of the key return only redacted metadata. Rotation is transactional and idempotent per predecessor: concurrent rotation attempts yield a single successor and losers receive `409 Conflict`. Requires the `admin:configure` permission and a confirmed step-up challenge bound to this action and payload hash.",
        "operationId": "rotateApiKey",
        "security": [{ "bearerAuth": [] }],
        "x-required-permission": "admin:configure",
        "x-requires-step-up": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RotateApiKeyInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successor key issued; raw key material is returned only in this response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiKeyRotationResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "428": { "$ref": "#/components/responses/StepUpRequired" }
        }
      }
    },
    "/api/admin/api-keys/{id}/revoke": {
      "parameters": [
        { "$ref": "#/components/parameters/ApiKeyIdParam" }
      ],
      "post": {
        "tags": ["Admin"],
        "summary": "Immediately revoke an API key",
        "description": "Revokes the key immediately, including any key still inside its rotation overlap window. Revocation is auditable: the response records the actor, reason, and timestamp. Requires the `admin:configure` permission.",
        "operationId": "revokeApiKey",
        "security": [{ "bearerAuth": [] }],
        "x-required-permission": "admin:configure",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RevokeApiKeyInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Key revoked",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiKey" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/admin/step-up/challenges": {
      "post": {
        "tags": ["Admin"],
        "summary": "Issue a step-up verification challenge",
        "description": "Issues a short-lived, single-use challenge bound to the requested action and the SHA-256 hash of the canonical request payload. The challenge expires after `STEP_UP_CHALLENGE_TTL_SECONDS` (default 300 seconds). The caller confirms the challenge out-of-band (second factor) and then submits the confirmation token with the high-impact request. Requires the `admin:operate` permission.",
        "operationId": "createStepUpChallenge",
        "security": [{ "bearerAuth": [] }],
        "x-required-permission": "admin:operate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StepUpChallengeInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Challenge issued",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StepUpChallenge" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/step-up/challenges/{challengeId}/confirm": {
      "parameters": [
        { "$ref": "#/components/parameters/ChallengeIdParam" }
      ],
      "post": {
        "tags": ["Admin"],
        "summary": "Confirm a step-up verification challenge",
        "description": "Confirms the challenge with the second-factor code. On success the challenge becomes a single-use confirmation token bound to the original action and payload hash. Confirmation fails with `410 Gone` when the challenge has expired, `409 Conflict` when it was already used, and `422 Unprocessable Entity` when the action or payload hash does not match the request being authorized. Requires the `admin:operate` permission.",
        "operationId": "confirmStepUpChallenge",
        "security": [{ "bearerAuth": [] }],
        "x-required-permission": "admin:operate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StepUpConfirmationInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Challenge confirmed; confirmation token issued",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StepUpConfirmation" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "410": { "$ref": "#/components/responses/Gone" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      }
    },
    "/api/admin/contracts/{contractId}/upgrade": {
      "parameters": [
        { "$ref": "#/components/parameters/ContractIdParam" }
      ],
      "post": {
        "tags": ["Admin"],
        "summary": "Upgrade a contract to a new WASM hash",
        "description": "High-impact configuration change. Requires the `admin:configure` permission and a confirmed, single-use step-up challenge bound to the `contract.upgrade` action and the SHA-256 hash of the canonical request payload. Missing step-up yields `428 Precondition Required`; expired challenges yield `410 Gone`; reused challenges yield `409 Conflict`; mismatched action or payload hash yields `422 Unprocessable Entity`. Every attempt, successful or not, is recorded in the audit log with the actor, action, payload hash, and challenge id.",
        "operationId": "upgradeContract",
        "security": [{ "bearerAuth": [] }],
        "x-required-permission": "admin:configure",
        "x-requires-step-up": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ContractUpgradeInput" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Upgrade accepted for execution",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContractUpgradeResult" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "410": { "$ref": "#/components/responses/Gone" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "428": { "$ref": "#/components/responses/StepUpRequired" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "PageParam": {
        "name": "page",
        "in": "query",
        "description": "Page number (1-based)",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "LimitParam": {
        "name": "limit",
        "in": "query",
        "description": "Maximum number of items per page",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      },
      "CursorParam": {
        "name": "cursor",
        "in": "query",
        "description": "Opaque cursor for pagination",
        "schema": { "type": "string" }
      },
      "TagIdParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Tag identifier",
        "schema": { "type": "string" }
      },
      "AddressParam": {
        "name": "address",
        "in": "path",
        "required": true,
        "description": "Stellar account address",
        "schema": { "type": "string" }
      },
      "TokenParam": {
        "name": "token",
        "in": "path",
        "required": true,
        "description": "Token identifier (asset code or contract address)",
        "schema": { "type": "string" }
      },
      "ApiKeyIdParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "API key identifier",
        "schema": { "type": "string" }
      },
      "ChallengeIdParam": {
        "name": "challengeId",
        "in": "path",
        "required": true,
        "description": "Step-up challenge identifier",
        "schema": { "type": "string" }
      },
      "ContractIdParam": {
        "name": "contractId",
        "in": "path",
        "required": true,
        "description": "Contract identifier",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "ApiErrorResponse": {
        "description": "A standardized API error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication required or invalid credentials",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated but not permitted (e.g. not the original owner)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Conflict": {
        "description": "State transition conflict (name reserved, stale restore proof, or concurrent transition lost)",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Gone": {
        "description": "Reservation window expired or step-up challenge expired; the operation can no longer proceed",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "UnprocessableEntity": {
        "description": "Step-up challenge action or payload hash does not match the request being authorized",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "StepUpRequired": {
        "description": "A confirmed step-up challenge is required for this high-impact action",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      }
    },
    "schemas": {
      "TagInput": {
        "type": "object",
        "required": ["username", "address"],
        "properties": {
          "username": { "type": "string" },
          "address": { "type": "string" }
        }
      },
      "Tag": {
        "type": "object",
        "required": ["id", "username", "address"],
        "properties": {
          "id": { "type": "string" },
          "username": { "type": "string" },
          "address": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "deletedAt": { "type": "string", "format": "date-time" }
        }
      },
      "TagList": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Tag" } },
          "totalCount": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "currentPage": { "type": "integer" }
        }
      },
      "ActivityList": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "nextCursor": { "type": "string" },
          "hasMore": { "type": "boolean" }
        }
      },
      "Stats": {
        "type": "object",
        "description": "Aggregate metrics and the refresh watermark for the reporting read model.",
        "additionalProperties": true
      },
      "StatsRefreshStatus": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["idle", "refreshing", "succeeded", "failed"] },
          "sourceWatermark": { "type": "string", "format": "date-time" },
          "startedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time" },
          "error": { "type": "string" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["success", "error"],
        "properties": {
          "success": { "type": "boolean", "const": false },
          "error": {
            "type": "object",
            "required": ["code", "message", "retryable"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_INPUT",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "METHOD_NOT_ALLOWED",
                  "GONE",
                  "CONFLICT",
                  "PAYLOAD_TOO_LARGE",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "VALIDATION_FAILED",
                  "RATE_LIMITED",
                  "INTERNAL_ERROR",
                  "UPSTREAM_ERROR",
                  "SERVICE_UNAVAILABLE",
                  "INSUFFICIENT_PERMISSION",
                  "STEP_UP_REQUIRED",
                  "STEP_UP_CHALLENGE_EXPIRED",
                  "STEP_UP_CHALLENGE_REUSED",
                  "STEP_UP_CHALLENGE_MISMATCH"
                ]
              },
              "message": { "type": "string" },
              "retryable": { "type": "boolean" },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["field", "message"],
                  "properties": {
                    "field": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "correlation_id": { "type": "string" },
          "reference_id": { "type": "string" }
        }
      },
      "HealthStatus": {
        "type": "object",
        "required": ["status", "timestamp", "database", "redis", "horizon"],
        "properties": {
          "status": { "type": "string", "enum": ["UP"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "database": { "type": "string", "enum": ["up"] },
          "redis": { "type": "string", "enum": ["up", "not configured"] },
          "horizon": { "type": "string", "enum": ["up"] }
        }
      },
      "FederationEntry": {
        "type": "object",
        "required": ["stellar_address", "account_id"],
        "properties": {
          "stellar_address": { "type": "string" },
          "account_id": { "type": "string" },
          "memo_type": { "type": "string" },
          "memo": { "type": "string" }
        }
      },
      "LookupResult": {
        "type": "object",
        "properties": {
          "username": { "type": "string" },
          "address": { "type": "string" },
          "primary": { "type": "string" },
          "usernames": { "type": "array", "items": { "type": "string" } },
          "data": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "totalCount": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "currentPage": { "type": "integer" }
        }
      },
      "RestoreTagInput": {
        "type": "object",
        "required": ["deletedAt"],
        "properties": {
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The `deletedAt` value observed at deletion time; used as restoration proof. A mismatch is rejected with 409 Conflict."
          }
        }
      },
      "AdminPermission": {
        "type": "string",
        "description": "Policy-based administrative permission. `admin:read` grants read-only access, `admin:operate` grants operational actions, and `admin:configure` grants configuration-changing actions. Higher scopes do not implicitly grant lower ones unless the role policy states so.",
        "enum": ["admin:read", "admin:operate", "admin:configure"]
      },
      "ApiKey": {
        "type": "object",
        "required": ["id", "prefix", "status", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "prefix": { "type": "string", "description": "Non-secret key prefix for identification" },
          "status": { "type": "string", "enum": ["active", "rotating", "revoked", "expired"] },
          "predecessorId": { "type": "string", "nullable": true, "description": "Key this key replaced, if any" },
          "successorId": { "type": "string", "nullable": true, "description": "Key that replaced this key, if any" },
          "overlapEndsAt": {
            "type": "string",
            "format": "date-time",
            "description": "End of the rotation overlap window; the predecessor is revoked at this instant"
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "revokedAt": { "type": "string", "format": "date-time" },
          "revokedBy": { "type": "string", "description": "Actor that revoked the key" },
          "revocationReason": { "type": "string" }
        }
      },
      "RotateApiKeyInput": {
        "type": "object",
        "properties": {
          "overlapHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 168,
            "description": "Requested overlap window in hours. Capped by the server-side `API_KEY_ROTATION_MAX_OVERLAP_HOURS` setting."
          },
          "stepUpToken": {
            "type": "string",
            "description": "Single-use confirmation token from a confirmed step-up challenge bound to this action and payload hash"
          }
        }
      },
      "ApiKeyRotationResult": {
        "type": "object",
        "required": ["predecessor", "successor", "key"],
        "properties": {
          "predecessor": { "$ref": "#/components/schemas/ApiKey" },
          "successor": { "$ref": "#/components/schemas/ApiKey" },
          "key": {
            "type": "string",
            "description": "Raw key material. Returned exactly once at rotation time and never again; later reads are redacted."
          },
          "overlapEndsAt": { "type": "string", "format": "date-time" }
        }
      },
      "RevokeApiKeyInput": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "StepUpChallengeInput": {
        "type": "object",
        "required": ["action", "payloadHash"],
        "properties": {
          "action": {
            "type": "string",
            "description": "High-impact action being authorized",
            "enum": ["contract.upgrade", "treasury.change", "bulk.export", "api_key.rotate"]
          },
          "payloadHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hex digest of the canonical request payload"
          }
        }
      },
      "StepUpChallenge": {
        "type": "object",
        "required": ["challengeId", "action", "payloadHash", "expiresAt"],
        "properties": {
          "challengeId": { "type": "string" },
          "action": { "type": "string" },
          "payloadHash": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "StepUpConfirmationInput": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "description": "Second-factor verification code" }
        }
      },
      "StepUpConfirmation": {
        "type": "object",
        "required": ["stepUpToken", "action", "payloadHash", "expiresAt"],
        "properties": {
          "stepUpToken": { "type": "string", "description": "Single-use confirmation token to submit with the high-impact request" },
          "action": { "type": "string" },
          "payloadHash": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "ContractUpgradeInput": {
        "type": "object",
        "required": ["wasmHash", "stepUpToken"],
        "properties": {
          "wasmHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "stepUpToken": { "type": "string" }
        }
      },
      "ContractUpgradeResult": {
        "type": "object",
        "required": ["contractId", "wasmHash", "status", "auditId"],
        "properties": {
          "contractId": { "type": "string" },
          "wasmHash": { "type": "string" },
          "status": { "type": "string", "enum": ["accepted", "in_progress", "succeeded", "failed"] },
          "auditId": { "type": "string", "description": "Audit record correlating actor, action, payload hash, and challenge id" }
        }
      }
    }
  }
}
