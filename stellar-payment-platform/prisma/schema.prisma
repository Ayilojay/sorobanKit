// Prisma schema for the Stellar Payment Platform.
// Migrated from a raw SQLite database to PostgreSQL for higher concurrency.
//
// The DATABASE_URL is read from the environment (see .env.example):
//   DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "tracing"]
}

// Federation registry mapping a human-readable username (e.g. "lekan*localhost")
// to its Stellar address. Maps to the legacy "username_registry" table so the
// data shape is preserved across the SQLite -> PostgreSQL migration.
//
// #613 — an address may carry several usernames (aliases), e.g.
// "payments*domain" and "support*domain" for one business account. `address`
// is therefore no longer unique; `isPrimary` marks the one username that
// reverse (type=id) federation lookups resolve to. The first username
// registered for an address is its primary.
//
// #386 — Active-primary invariant: for any given `address` there may be at
// most ONE row with `is_primary = true` and `deleted_at IS NULL`. Soft-deleted
// rows (`deleted_at IS NOT NULL`) are ignored by the invariant, so a deleted
// primary does not block a new primary for the same address, and a soft-delete
// of the current primary frees the slot for a replacement.
//
// Prisma cannot express partial unique indexes, so this invariant is enforced
// by a raw-SQL partial unique index created in the migration
// `prisma/migrations/<timestamp>_user_active_primary_unique/migration.sql`:
//
//   CREATE UNIQUE INDEX "username_registry_address_active_primary_key"
//     ON "username_registry" ("address")
//     WHERE "is_primary" = true AND "deleted_at" IS NULL;
//
// That migration also repairs legacy duplicate primaries (keeping the oldest
// non-deleted primary per address and demoting the rest) before the index is
// created. Do not drop or rename the index without updating this comment.
model User {
  username  String    @id
  address   String
  isPrimary Boolean   @default(false) @map("is_primary")
  memoType  String?   @map("memo_type")
  memo      String?
  createdAt DateTime  @default(now()) @map("created_at")
  flaggedAt DateTime? @map("flagged_at")
  deletedAt DateTime? @map("deleted_at")
  webhooks  Webhook[] // <-- add this line
  activity  ActivityLog[]

  @@index([username])
  // Reverse federation lookups (type=id) and /lookup?address= filter by
  // address, which is no longer backed by a unique index.
  @@index([address])
  // #386 — Supports the active-primary invariant: the legacy-duplicate repair
  // query (find all non-deleted primaries for an address) and the partial
  // unique index predicate both filter on (address, is_primary, deleted_at).
  @@index([address, isPrimary, deletedAt])
  // Serves the keyset (cursor) pagination seeks used by the /users and
  // /lookup list endpoints: (created_at DESC, username DESC) walks this
  // index backwards, so page depth no longer affects query cost.
  @@index([createdAt, username])
  @@map("username_registry")
}

// Webhook registrations: merchants/users register a URL that receives POST
// notifications whenever a payment is successfully routed to one of their
// registered Stellar addresses.
model Webhook {
  id           String    @id @default(uuid())
  username     String
  user         User      @relation(fields: [username], references: [username], onDelete: Cascade)
  url          String
  secret       String // HMAC-SHA256 signing secret for payload verification
  events       String[]  @default(["*"]) // Optional event filter; "*" preserves the legacy all-events behavior.
  createdAt    DateTime  @default(now()) @map("created_at")
  lastSentAt   DateTime? @map("last_sent_at")
  failingSince DateTime? @map("failing_since")

  @@unique([username, url])
  @@index([username])
  @@index([lastSentAt])
  @@map("webhooks")
}

// Approved merchant frontend origins allowed to call the API. CORS
// validation (see server.js) checks incoming Origin headers against this
// table, with results cached in Redis so most requests avoid a DB round trip.
model ApprovedOrigin {
  id        String   @id @default(uuid())
  origin    String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("approved_origins")
}

// Payment records for routing, statistics, and auditing.
// #384 — Monetary values are stored as exact integer "units" (the smallest
// indivisible unit of the asset) rather than floating point. `amountUnits`
// and `feeUnits` are the canonical values; `assetPrecision` records how many
// decimal places the asset uses (7 for XLM and most Stellar assets) so the
// units can be converted back to a human-readable decimal without loss.
// Rounding policy: values are rounded half-up to `assetPrecision` decimal
// places before being converted to units; anything finer than one unit is
// rejected at the API boundary rather than silently truncated.
//
// #385 — `network` identifies the Stellar network a transaction belongs to
// (e.g. "testnet", "pubnet"). The same transaction hash can legitimately
// exist on distinct networks, so uniqueness is enforced on the composite
// (network, transactionHash) pair instead of the hash alone.
model Payment {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now()) @map("created_at")
  fromAddress     String   @map("from_address")
  toAddress       String   @map("to_address")
  amountUnits     BigInt   @map("amount_units")
  feeUnits        BigInt   @default(0) @map("fee_units")
  assetPrecision  Int      @default(7) @map("asset_precision")
  assetCode       String?  @map("asset_code")
  transactionHash String?  @map("transaction_hash")
  // Backfill policy: existing rows are assigned the default network
  // ("testnet") by the expand/backfill migration, since all pre-existing
  // records were ingested from the testnet deployment.
  network         String   @default("testnet")
  status          String   @default("completed")

  @@unique([network, transactionHash])
  @@index([network])
  @@index([createdAt])
  @@index([fromAddress])
  @@index([toAddress])
  @@map("payments")
}

// Dead-letter queue: holds webhook delivery attempts that have permanently
// failed (exhausted all retries).  Admin endpoints can list and manually
// replay individual entries so no critical event is lost.
model WebhookDLQ {
  id              String    @id @default(uuid())
  webhookId       String    @map("webhook_id")
  webhookUrl      String    @map("webhook_url")
  webhookSecret   String    @map("webhook_secret")
  username        String
  eventType       String    @map("event_type")
  eventPayload    String    @map("event_payload")
  failureReason   String    @map("failure_reason")
  deliveryAttempts Int      @default(0) @map("delivery_attempts")
  movedAt         DateTime  @default(now()) @map("moved_at")
  replayed        Boolean   @default(false)
  replayedAt      DateTime? @map("replayed_at")

  @@index([username])
  @@index([webhookId])
  @@index([movedAt])
  @@map("webhook_dlq")
}

// API keys for backend consumers. Only the SHA-256 hash of the secret is
// stored; the raw key is shown once at creation time.
model ApiKey {
  id          String    @id @default(uuid())
  name        String
  ownerId     String    @map("owner_id")
  keyHash     String    @unique @map("key_hash")
  keyPrefix   String    @map("key_prefix")
  scopes      String[]  @default(["read", "write"])
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedBy   String?   @map("revoked_by")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([ownerId])
  @@index([keyHash])
  @@map("api_keys")
}

// PaymentIntent model for storing requested payment registrations. These are
// created via the bulk registration endpoint and persisted atomically using
// `prisma.$transaction`.
//
// #377 — Bulk creation is atomic and externally identifiable:
//   * `batchId` is a stable identifier for one bulk submission. Every item in
//     the same request shares it, so a caller can correlate the whole batch
//     (and retry it) without relying on the per-item ids.
//   * `itemIndex` preserves the caller-supplied ordering of items within a
//     batch (0-based). It is unique per batch so ordering is deterministic.
//   * `(batchId, externalId)` is unique, making retries of a batch that
//     repeats the same caller-supplied external ids idempotent instead of
//     creating duplicate intents. `externalId` is optional, so the constraint
//     only applies to rows that actually carry one (Postgres treats NULLs as
//     distinct, so multiple rows without an externalId are still allowed).
model PaymentIntent {
  id         String   @id @default(uuid())
  batchId    String?  @map("batch_id")
  itemIndex  Int?     @map("item_index")
  externalId String?  @map("external_id")
  from       String
  to         String
  amount     String
  asset      String?
  memoType   String?  @map("memo_type")
  memo       String?
  metadata   Json?
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([to])
  @@index([from])
  // Composite index for dashboard-style list queries that filter by status
  // and sort/filter by date (e.g. "pending intents created since X"), so
  // those WHERE ... ORDER BY combinations use an index scan instead of a
  // full table scan.
  @@index([status, createdAt])
  // Idempotent retries: a repeated externalId within the same batch maps to
  // the same intent rather than inserting a duplicate.
  @@unique([batchId, externalId])
  // Deterministic ordering of items within a batch.
  @@unique([batchId, itemIndex])
  // Batch lookups (e.g. "fetch all intents for batch X in order").
  @@index([batchId, itemIndex])
  @@map("payment_intents")
}

// AuditLog model for tracking all mutating admin actions and security events.
//
// #381 — Audit records are tamper-evident: each row carries a keyed digest
// over its canonicalized content plus the digest of the previous record in
// the chain (`prevDigest`), forming a hash chain. `keyId` records which
// signing key produced the digest so keys can be rotated without breaking
// verification of older records. The first record in a chain has a null
// `prevDigest`. Verification tooling recomputes digests in `createdAt, id`
// order and reports the first mismatch.
model AuditLog {
  id         String   @id @default(uuid())
  action     String
  method     String
  path       String
  userId     String?  @map("user_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  statusCode Int?     @map("status_code")
  payload    String?
  // Keyed digest (HMAC) over the canonicalized record content.
  digest     String?
  // Digest of the immediately preceding audit record; null for the chain head.
  prevDigest String?  @map("prev_digest")
  // Identifier of the signing key used to compute `digest` (supports rotation).
  keyId      String?  @map("key_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  // Chain verification walks records in (created_at, id) order.
  @@index([createdAt, id])
  @@index([prevDigest])
  @@index([keyId])
  @@map("audit_logs")
}

// #382 — Per-network Horizon stream cursors. The ingestion worker persists the
// last fully processed page cursor atomically after each page so restarts and
// failovers resume from the last committed point instead of replaying from the
// beginning. `(network, stream)` is unique so cursors are upserted atomically.
model StreamCursor {
  id        String   @id @default(uuid())
  network   String
  stream    String
  cursor    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([network, stream])
  @@index([network])
  @@map("stream_cursors")
}

// WebhookEvent tracks every individual webhook delivery attempt end-to-end,
// from initial queueing through retries to final delivery or dead-letter
// promotion. The worker polls by status on every cycle (pending → delivered /
// failed / dead_letter), so @@index([status]) prevents a full table scan
// that would grow linearly with event volume.
model WebhookEvent {
  id              String    @id @default(uuid())
  eventType       String    @map("event_type")
  payload         String    // JSON-serialised event payload
  merchantId      String?   @map("merchant_id")
  // Lifecycle: pending → delivered | failed → dead_letter
  status          String    @default("pending")
  attemptCount    Int       @default(0) @map("attempt_count")
  lastError       String?   @map("last_error")
  deliveredAt     DateTime? @map("delivered_at")
  // When the DLQ worker promotes a failed event it records the source row id
  // here so the two records can be correlated for replay.
  originalEventId String?   @map("original_event_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  // The worker's polling query is always WHERE status = <value>, so a single
  // index on status keeps those scans efficient regardless of table size.
  @@index([status])
  @@map("webhook_events")
}

// #599 — Self-service activity trail. Records the account-affecting events a
// user can review for their own username through
// GET /users/:username/activity. Rows go away with the user so a purge does
// not leave an orphaned trail behind.
//
// #182 — The `onDelete: Cascade` on the `user` relation below is the source of
// truth for purge cleanup: the soft-delete purge cron relies on it (and also
// deletes activity rows explicitly inside its transaction) so a purged user
// never leaves orphaned activity_logs behind. The deployed migration history
// must match this declaration; if a database was created before the cascade
// was added, apply the migration that recreates the FK with ON DELETE CASCADE.
model ActivityLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [username], onDelete: Cascade)
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("activity_logs")
}

// #375 — Durable background export jobs. Large administrative exports are
// created as rows here and processed by a bounded-concurrency worker instead
// of being streamed inline in the request. The row is the source of truth for
// ownership checks, progress reporting, cancellation and the expiring
// download artifact.
//
// Lifecycle: pending → running → completed | failed | cancelled
//   - `progress` / `totalRows` drive progress reporting.
//   - `cancelledAt` is set when an owner cancels; the worker observes it and
//     stops streaming to the artifact.
//   - `artifactPath` / `artifactBytes` point at the streamed artifact in
//     artifact storage; `expiresAt` bounds how long it can be downloaded and
//     is swept by the cleanup job.
model ExportJob {
  id            String    @id @default(uuid())
  ownerId       String    @map("owner_id")
  status        String    @default("pending")
  format        String
  filters       Json
  progress      Int       @default(0)
  totalRows     Int?      @map("total_rows")
  artifactPath  String?   @map("artifact_path")
  artifactBytes Int?      @map("artifact_bytes")
  error         String?
  cancelledAt   DateTime? @map("cancelled_at")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([status])
  @@index([expiresAt])
  // Ownership-scoped listing: WHERE owner_id = ? AND status = ?
  @@index([ownerId, status])
  // Worker polling and cleanup: WHERE status = ? ORDER BY created_at
  @@index([status, createdAt])
  @@map("export_jobs")
}
