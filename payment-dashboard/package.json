{
  "name": "payment-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyze": "vite build --mode analyze",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "api:generate": "node scripts/generate-api-types.mjs",
    "api:check": "node scripts/generate-api-types.mjs --check",
    "preview": "vite preview",
    "budget": "node scripts/check-bundle-budget.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:ci": "npm run lint && npm run typecheck && npm run test && npm run budget && npm run test:visual"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^1.7.5",
    "@stellar-tags/payment-router": "file:../packages/types",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.0.0",
    "date-fns": "^4.4.0",
    "openapi-fetch": "^0.17.0",
    "pino": "^9.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.6.0",
    "uuid": "^11.0.0",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.10.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "5.12.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.10",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.11"
  }
}